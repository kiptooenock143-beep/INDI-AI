    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  },
  "main": "electron/main.cjs",
  "productName": "INDI AI",
  "description": "INDI AI desktop application",
  "build": {
    "appId": "com.exile.ai",
    "productName": "INDI AI",
    "directories": {
      "buildResources": "assets",
      "output": "electron-release-optimized"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "local/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/exile-reactor.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "INDI AI"
    },
    "asar": true
  }
}
