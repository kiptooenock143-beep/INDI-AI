{
  "name": "indi-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "package:win": "npm run build && npm run icons && electron-builder --win nsis",
    "icons": "node scripts/build-icons.cjs",
    "test:phase1": "node --test test/task-foundation.test.mjs test/arc-system-core.test.mjs test/arc-connectivity.test.mjs test/arc-autonomy-engine.test.mjs",
